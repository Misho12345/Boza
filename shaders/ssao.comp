#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

struct CameraUBO {
    mat4 view;
    mat4 proj;
};

struct LightingUBO {
    vec4 view_pos;
    vec4 ambient_color;
    uvec4 light_counts;
    uvec4 cluster_grid;
    vec4 screen_params;
    vec4 shadow_params;
    vec4 directional_shadow_splits;
    mat4 directional_shadow_view_projections[4];
};

layout(set = 0, binding = 0, std430) readonly buffer CameraDataBuffer {
    CameraUBO data;
} camera_data;

layout(set = 0, binding = 1, std430) readonly buffer LightingDataBuffer {
    LightingUBO data;
} lighting_data;

layout(set = 0, binding = 2) uniform sampler2D depth_texture;
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D ssao_texture;

const float PI = 3.14159265359;
const float radius = 0.8;
const float bias = 0.02;

const vec3 kernel[8] = vec3[](
    vec3(0.5381, 0.1856, 0.4319),
    vec3(0.1379, 0.2486, 0.4430),
    vec3(0.3371, 0.5679, 0.0057),
    vec3(-0.6999, -0.0451, 0.0019),
    vec3(0.0689, -0.1598, 0.8547),
    vec3(0.0560, 0.0069, 0.1843),
    vec3(-0.0146, 0.1402, 0.0762),
    vec3(0.0100, -0.1924, 0.0344)
);

float sample_depth(vec2 uv)
{
    return texture(depth_texture, clamp(uv, vec2(0.0), vec2(1.0))).r;
}

vec3 reconstruct_view_position(vec2 uv, float depth)
{
    vec4 clip = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 view = inverse(camera_data.data.proj) * clip;
    return view.xyz / max(view.w, 1e-5);
}

vec3 compute_view_normal(vec2 uv, vec2 texel_size, vec3 center_view_pos)
{
    vec2 sample_uv_x = clamp(uv + vec2(texel_size.x, 0.0), vec2(0.0), vec2(1.0));
    vec2 sample_uv_y = clamp(uv + vec2(0.0, texel_size.y), vec2(0.0), vec2(1.0));

    vec3 view_pos_x = reconstruct_view_position(sample_uv_x, sample_depth(sample_uv_x));
    vec3 view_pos_y = reconstruct_view_position(sample_uv_y, sample_depth(sample_uv_y));

    vec3 dx = view_pos_x - center_view_pos;
    vec3 dy = view_pos_y - center_view_pos;
    vec3 normal = normalize(cross(dx, dy));

    if (dot(normal, -center_view_pos) < 0.0) normal = -normal;
    if (any(isnan(normal)) || length(normal) <= 1e-4) return vec3(0.0, 0.0, -1.0);
    return normal;
}

float random_angle(ivec2 pixel)
{
    return fract(sin(dot(vec2(pixel), vec2(12.9898, 78.233))) * 43758.5453) * 2.0 * PI;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(ssao_texture);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    float depth = sample_depth(uv);
    if (depth >= 0.99999)
    {
        imageStore(ssao_texture, pixel, vec4(1.0));
        return;
    }

    vec3 view_pos = reconstruct_view_position(uv, depth);
    vec2 texel_size = 1.0 / vec2(size);
    vec3 normal = compute_view_normal(uv, texel_size, view_pos);

    float angle = random_angle(pixel);
    vec3 random_vec = vec3(cos(angle), sin(angle), fract(angle * 0.61803398875));
    vec3 tangent = normalize(random_vec - normal * dot(random_vec, normal));
    vec3 bitangent = cross(normal, tangent);
    mat3 tbn = mat3(tangent, bitangent, normal);

    float occlusion = 0.0;

    for (int i = 0; i < 8; ++i)
    {
        vec3 sample_view_pos = view_pos + tbn * kernel[i] * radius;
        vec4 sample_clip = camera_data.data.proj * vec4(sample_view_pos, 1.0);
        if (abs(sample_clip.w) <= 1e-5) continue;

        vec3 sample_ndc = sample_clip.xyz / sample_clip.w;
        vec2 sample_uv = sample_ndc.xy * 0.5 + 0.5;
        if (sample_uv.x <= 0.0 || sample_uv.x >= 1.0 || sample_uv.y <= 0.0 || sample_uv.y >= 1.0) continue;

        float occluder_depth = sample_depth(sample_uv);
        if (occluder_depth >= 0.99999) continue;

        vec3 occluder_view_pos = reconstruct_view_position(sample_uv, occluder_depth);
        float range_weight = smoothstep(0.0, 1.0, radius / (abs(view_pos.z - occluder_view_pos.z) + 1e-4));
        float blocked = occluder_view_pos.z < sample_view_pos.z - bias ? 1.0 : 0.0;
        occlusion += blocked * range_weight;
    }

    float ao = clamp(1.0 - occlusion / 8.0, 0.0, 1.0);
    imageStore(ssao_texture, pixel, vec4(vec3(ao), 1.0));
}
