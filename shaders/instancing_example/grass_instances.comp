#version 450

#include "../common/fbm.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct CullInstance {
    mat4 model;
    vec4 sphere;
};

layout(set = 0, binding = 0, std430) writeonly buffer CandidateBuffer {
    CullInstance items[];
} cull_candidates;

layout(set = 0, binding = 1) uniform sampler2D height_map;

layout(push_constant) uniform PC {
    uint instance_count;
    uint patches_per_row;
    uint seed;
    float terrain_extent;
    float patch_radius;
    float height_scale;
} pc;

float rand01(uint value)
{
    return float(hash_u32(value)) * (1.0 / 4294967295.0);
}

mat3 rotation_y(float angle)
{
    float s = sin(angle);
    float c = cos(angle);

    return mat3(
        vec3(c, 0.0, -s),
        vec3(0.0, 1.0, 0.0),
        vec3(s, 0.0, c)
    );
}

mat3 rotation_axis(vec3 axis, float angle)
{
    axis = normalize(axis);

    float s = sin(angle);
    float c = cos(angle);
    float t = 1.0 - c;

    return mat3(
        t * axis.x * axis.x + c,
        t * axis.x * axis.y + s * axis.z,
        t * axis.x * axis.z - s * axis.y,

        t * axis.x * axis.y - s * axis.z,
        t * axis.y * axis.y + c,
        t * axis.y * axis.z + s * axis.x,

        t * axis.x * axis.z + s * axis.y,
        t * axis.y * axis.z - s * axis.x,
        t * axis.z * axis.z + c
    );
}

vec2 patch_center(uint patch_index)
{
    float half_extent = pc.terrain_extent * 0.5;
    float grid_extent = half_extent - pc.patch_radius;
    float spacing = (2.0 * grid_extent) / max(float(pc.patches_per_row - 1u), 1.0);

    uint row = patch_index / pc.patches_per_row;
    uint col = patch_index % pc.patches_per_row;

    float base_x = -grid_extent + float(col) * spacing;
    float base_z = -grid_extent + float(row) * spacing;

    float offset_x = mix(-spacing * 0.15, spacing * 0.15, rand01(pc.seed ^ (patch_index * 0x9e3779b9u)));
    float offset_z = mix(-spacing * 0.15, spacing * 0.15, rand01(pc.seed ^ (patch_index * 0x85ebca6bu)));

    return vec2(base_x + offset_x, base_z + offset_z);
}

float sample_terrain_height(vec2 world_xz)
{
    float half_extent = pc.terrain_extent * 0.5;
    vec2 uv = clamp((world_xz + vec2(half_extent)) / pc.terrain_extent, vec2(0.0), vec2(1.0));
    float encoded_height = textureLod(height_map, uv, 0.0).r;
    return pc.height_scale * (encoded_height * 2.0 - 1.0);
}

void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index >= pc.instance_count) return;

    uint patch_count = pc.patches_per_row * pc.patches_per_row;
    uint patch_index = hash_u32(pc.seed ^ (index * 0x27d4eb2du)) % max(patch_count, 1u);
    vec2 center = patch_center(patch_index);

    float angle = rand01(pc.seed + index * 17u) * 6.28318530718;
    float distance = sqrt(rand01(pc.seed + index * 37u)) * pc.patch_radius;

    float x = center.x + cos(angle) * distance;
    float z = center.y + sin(angle) * distance;

    float half_extent = pc.terrain_extent * 0.5;
    x = clamp(x, -half_extent, half_extent);
    z = clamp(z, -half_extent, half_extent);

    float y = sample_terrain_height(vec2(x, z));

    float yaw = rand01(pc.seed + index * 53u) * 6.28318530718;
    float tilt = mix(-0.08, 0.08, rand01(pc.seed + index * 71u));
    float width_scale = mix(1.85, 3.35, rand01(pc.seed + index * 89u));
    float height_scale = mix(1.9, 3.8, rand01(pc.seed + index * 97u));

    mat3 rotation = rotation_y(yaw) * rotation_axis(vec3(1.0, 0.0, 1.0), tilt);

    mat4 model = mat4(
        vec4(rotation[0] * width_scale, 0.0),
        vec4(rotation[1] * height_scale, 0.0),
        vec4(rotation[2] * width_scale, 0.0),
        vec4(x, y, z, 1.0)
    );

    vec3 center_offset = rotation * vec3(0.0, height_scale * 1.1, 0.0);
    vec3 sphere_center = vec3(x, y, z) + center_offset;
    float sphere_radius = max(height_scale * 1.3, width_scale * 0.55) + max(width_scale * 0.9, 1.15);

    cull_candidates.items[index].model = model;
    cull_candidates.items[index].sphere = vec4(sphere_center, sphere_radius);
}
