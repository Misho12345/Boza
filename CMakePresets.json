{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "Debug",
      "description": "Debug build",
      "binaryDir": "${sourceDir}/build/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "YES",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build/Debug/bin",
        "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/build/Debug/lib",
        "CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${sourceDir}/build/Debug/lib"
      }
    },
    {
      "name": "Release",
      "description": "Release build",
      "binaryDir": "${sourceDir}/build/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "YES",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build/Release/bin",
        "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/build/Release/lib",
        "CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${sourceDir}/build/Release/lib"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Debug",
      "configurePreset": "Debug",
      "description": "Build boza_game (Debug)",
      "targets": ["all"],
      "jobs": 4
    },
    {
      "name": "Release",
      "configurePreset": "Release",
      "description": "Build boza_game (Release)",
      "targets": ["all"],
      "jobs": 4
    },
    {
      "name": "game:Debug",
      "configurePreset": "Debug",
      "description": "Build boza_game only (Debug)",
      "targets": ["boza_game"],
      "jobs": 4
    },
    {
      "name": "game:Release",
      "configurePreset": "Release",
      "description": "Build boza_game only (Release)",
      "targets": ["boza_game"],
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "unit:Debug",
      "configurePreset": "Debug",
      "description": "Run unit tests via CTest (Debug)",
      "output": { "outputOnFailure": true },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "unit:Release",
      "configurePreset": "Release",
      "description": "Run unit tests via CTest (Release)",
      "output": { "outputOnFailure": true },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "all:Debug",
      "configurePreset": "Debug",
      "description": "Run all tests sequentially (Debug)",
      "output": { "outputOnFailure": true },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "all:Release",
      "configurePreset": "Release",
      "description": "Run all tests sequentially (Release)",
      "output": { "outputOnFailure": true },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    }
  ]
}